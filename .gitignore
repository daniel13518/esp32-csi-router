# ESP-IDF build output (regenerated by idf.py build)
/build/

# Auto-downloaded components (pinned by dependencies.lock)
/managed_components/

# Active config — GENERATED from sdkconfig.defaults on first build,
# and it holds your real WiFi SSID/password in plaintext. Never commit.
/sdkconfig
/sdkconfig.old

# Machine-specific IDE config (absolute IDF path etc.)
/.vscode/

# Python
__pycache__/
*.pyc
tools/.venv/
venv/

# Generated analysis output (regenerate with csi_quality.py)
tools/*.png

# Scratch / personal capture files (keep empty.csv & occupied.csv as samples)
tools/csi_data_log.txt
tools/test*.csv
tools/csi_data.csv
tools/_sc.csv
